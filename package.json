{
  "name": "expo-whats-new",
  "version": "0.1.3",
  "description": "Universal Expo package for showing What's New releases",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./headless": {
      "types": "./build/headless.d.ts",
      "default": "./build/headless.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "!build/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "ios",
    "android/src/main",
    "android/build.gradle",
    "expo-module.config.json",
    "scripts/*.sh",
    "skills",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "ARCHITECTURE.md",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "expo-module test",
    "test:logic": "expo-module test --watch=false src/logic",
    "test:source": "expo-module test --watch=false src/source",
    "test:storage": "expo-module test --watch=false src/storage",
    "test:react": "expo-module test --watch=false src/react --passWithNoTests",
    "test:core": "npm run test:logic && npm run test:source && npm run test:storage",
    "prepare": "bash scripts/prepare-module.sh",
    "verify": "npm run skills:validate && npm test -- --watch=false && npm run build && npm run lint && npm run example:typecheck",
    "doctor:example": "bash scripts/run-example-doctor.sh",
    "publish:check": "npm run verify && npm pack --dry-run",
    "prepublishOnly": "npm run verify && expo-module prepublishOnly",
    "expo-module": "expo-module",
    "release:prepare": "bash scripts/prepare-release.sh",
    "skills:install": "bash scripts/install-codex-skills.sh",
    "skills:validate": "bash scripts/validate-codex-skills.sh",
    "example:typecheck": "cd example && npx tsc --noEmit",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-whats-new",
    "ExpoWhatsNew"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Madraka/expo-whats-new.git"
  },
  "bugs": {
    "url": "https://github.com/Madraka/expo-whats-new/issues"
  },
  "author": "Madraka <asker_17@msn.com> (https://github.com/Madraka)",
  "license": "MIT",
  "homepage": "https://github.com/Madraka/expo-whats-new#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "~19.1.1",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "babel-jest": "^29.7.0",
    "expo": "^55.0.20",
    "expo-module-scripts": "^55.0.2",
    "jest": "^29.7.0",
    "react-native": "0.82.1",
    "react-test-renderer": "^19.2.5"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "@tootallnate/once": "^3.0.1",
    "postcss": "^8.5.10"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
